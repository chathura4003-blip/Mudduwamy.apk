# Database Connection (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sri_sumana_pirivena_erp
DB_USER=your_db_username
DB_PASS=your_db_password

# OneSignal Push Notification Private Server Credentials (Used by PHP Backend Only)
ONESIGNAL_APP_ID=d86127b5-1ef0-4f3e-86f2-66a5f211f30d
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here

# Google Gemini API Key (Server AI Engine & Exam Generator)
GEMINI_API_KEY=your_gemini_api_key_here
