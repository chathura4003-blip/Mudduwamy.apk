# ==============================================================================
# Sri Sumana Maha Pirivena ERP - Frontend Environment Configuration Example
# Copy this file to .env or .env.local as needed
# ==============================================================================

# Public API Base URL (Must match your deployment domain)
VITE_API_BASE_URL=https://srisumanamahapiriwena-lk.us.stackstaging.com

# Public Push Notification App ID
VITE_ONESIGNAL_APP_ID=d86127b5-1ef0-4f3e-86f2-66a5f211f30d

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# (Get key from: https://aistudio.google.com/app/apikey)
# ------------------------------------------------------------------------------
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# OpenRouter AI API Configuration (Optional / Fallback)
# (Get key from: https://openrouter.ai/keys)
# ------------------------------------------------------------------------------
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# AI Provider Settings: 'gemini' | 'openrouter'
VITE_PRIMARY_PROVIDER=gemini
VITE_FALLBACK_PROVIDER=openrouter
